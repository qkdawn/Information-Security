# Keep this repository scoped to Assignment1.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Assignment1/
!/.github/

# Local environments, generated caches, and temporary previews.
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
/Assignment1/tmp/
.env
.env.*
!.env.example

# Assignment1/design/ holds worked backdoor candidates and is already tracked.
# .gitignore cannot untrack it: Part 2 distribution must exclude it explicitly.
/Assignment1/design/tmp/
/Assignment1/design/*.new.py
