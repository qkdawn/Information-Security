# Keep this repository scoped to Assignment1.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Assignment1/
!/.github/

# Local environments, generated caches, and temporary previews.
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
/Assignment1/tmp/
.env
.env.*
!.env.example

# Assignment1/design/ holds worked backdoor candidates and is excluded from
# distribution. Untracked on 2026-11-20 with `git rm -r --cached`; local copies
# remain on disk. A tracked file cannot be hidden by .gitignore alone.
/Assignment1/design/
